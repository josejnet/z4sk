# Canonical public origin. Keep the Vercel URL until the custom domain is connected and verified.
SITE_URL=https://z4sk.vercel.app

# Required persistent database in production (provision through Vercel Marketplace/Neon).
DATABASE_URL=

# Required only for the isolated encrypted E2E suite. Never point this at production.
Z4SK_STAGING_DATABASE_URL=

# Required in production. Used for daily-rotating HMAC pseudonyms of rate-limit IPs.
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Public-launch legal and retention disclosure. These must be real, monitored values.
OPERATOR_NAME=
PRIVACY_EMAIL=
NEON_RESTORE_WINDOW_HOURS=

# Required in production to protect /founder and /api/founder/metrics.
FOUNDER_DASHBOARD_KEY=replace-with-a-long-random-secret

# Required by Vercel Cron to authorize the private retention endpoint.
CRON_SECRET=replace-with-a-long-random-secret

# Reserved for the one-tap payment phase. Payments remain disabled until configured.
STRIPE_SECRET_KEY=
STRIPE_PRICE_CUSTOM_THEME=
STRIPE_WEBHOOK_SECRET=

# Reserved for server-initiated PWA push or WhatsApp Business notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WHATSAPP_ACCESS_TOKEN=

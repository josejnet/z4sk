{
  "name": "z4sk-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/patch-eslint-jsx-a11y.mjs",
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node scripts/migrate.mjs",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "verify:e2ee": "node --env-file-if-exists=.env.local scripts/verify-e2ee.mjs",
    "verify:e2e:staging": "npm run build && node scripts/verify-e2e-staging.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@scure/bip39": "^2.4.0",
    "jsqr": "^1.4.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.4.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "type": "module"
}
